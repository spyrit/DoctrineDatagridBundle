parameters:
    level: 5
    paths:
        - Bridge
        - Datagrid
        - DoctrineDatagridBundle.php
        - Tests
    tmpDir: var/cache/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # phpoffice/phpspreadsheet is an optional dependency (requires ext-gd)
        -
            identifiers:
                - class.notFound
                - return.type
            paths:
                - Datagrid/Export/AbstractSpreadsheetExport.php
                - Datagrid/Export/AbstractXlsExport.php
                - Tests/Fixtures/Export/*
                - Tests/Export/ExportTest.php
        # compatibility with doctrine/orm 2.x (lowest dependencies)
        -
            identifier: function.alreadyNarrowedType
            path: Tests/OrmTestTrait.php
