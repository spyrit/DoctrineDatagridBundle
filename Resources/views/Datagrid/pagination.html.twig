{%- set extraParameters = extraParameters|default({}) -%}
{%- set display = display|default(2) -%}
{%- set page = datagrid.currentPage -%}
{%- set pages = datagrid.nbPages -%}

{%- if pages > 1 -%}
    {%- set available = [1] -%}
    {%- for candidate in (page - display)..(page + display) -%}
        {%- if candidate > 1 and candidate < pages -%}
            {%- set available = available|merge([candidate]) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- set available = available|merge([pages]) -%}

    <ul class="pagination">
    {%- set previous = 0 -%}
    {%- for currentPage in available -%}
        {%- if currentPage > previous + 1 -%}
            <li class="page-item disabled"><a onclick="return false;" href="#" class="page-link">...</a></li>
        {%- endif -%}
        {%- set isCurrent = currentPage == page -%}
        <li class="page-item{{ isCurrent ? ' active' }}"><a href="{{ datagrid.getPaginationPath(route, currentPage, extraParameters) }}" title="Page {{ currentPage }}" class="page-link{{ isCurrent ? ' active' }}">{{ currentPage }}</a></li>
        {%- set previous = currentPage -%}
    {%- endfor -%}
    </ul>
{%- endif -%}
